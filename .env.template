# Django
DEBUG=True
SECRET_KEY=your-super-secret-key-change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# База данных (PostgreSQL)
DATABASE_URL=postgres://user:password@127.0.0.1:5432/one_percent_db

# CORS (домены фронтенда через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis для Celery
REDIS_URL=redis://127.0.0.1:6379/0

# Выполнять Celery-задачи синхронно (True — для локальной отладки без Redis)
CELERY_TASK_ALWAYS_EAGER=False

# Telegram Bot (токен получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_URL=https://api.telegram.org
